VITE_OWNER_EMAIL=khalil@ultrapowerindustrialinc.com
VITE_GOOGLE_CALENDAR_ID=khalil.banares@gmail.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Do NOT add VITE_CLICKUP_API_KEY, VITE_GOOGLE_API_KEY,
# VITE_GOOGLE_CLIENT_SECRET, VITE_ANTHROPIC_API_KEY, or VITE_BREVO_API_KEY
# — see the README "Security notes" section. The ClickUp and Google API
# keys go to Supabase secrets (CLICKUP_API_KEY, GOOGLE_API_KEY) consumed
# by the clickup-proxy / google-calendar-proxy Edge Functions; the OAuth
# client secret, Anthropic key, and Brevo key go to Supabase secrets too
# (GOOGLE_CLIENT_SECRET, ANTHROPIC_API_KEY, BREVO_API_KEY) — none of them
# belong in a VITE_ variable, ever.

# Cloudflare Pages Function only (functions/api/intake.js) — never a VITE_
# var, never shipped to the browser. Set in Cloudflare Pages → Settings →
# Environment variables, and for local `wrangler pages dev` in .dev.vars.
INTAKE_WEBHOOK_SECRET=generate-a-random-token
